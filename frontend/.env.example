# Copy to frontend/.env.local for local development.
API_URL=http://localhost:8000                 # backend base URL used by the /api/v1 proxy (build time)
NEXT_PUBLIC_SUPABASE_URL=                     # required when the backend runs in supabase auth mode
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE=                         # static hosting only: public URL of the API (e.g. https://ardentum-api-xyz.a.run.app)
NEXT_OUTPUT=                                  # "export" for static hosting (Cloudflare Pages); empty for the Node server
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=false          # true only after configuring custom SMTP in Supabase
