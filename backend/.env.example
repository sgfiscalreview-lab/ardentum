# Copy to backend/.env for local development. Never commit real secrets.
ARDENTUM_ENV=development                      # development | test | production
ARDENTUM_DATABASE_URL=sqlite:///./ardentum-dev.sqlite3   # production: postgresql://user:pass@host:5432/db
ARDENTUM_CORS_ORIGINS=["http://localhost:3000"]
ARDENTUM_CORS_ORIGIN_REGEX=                   # e.g. ^https://[a-z0-9-]+\.ardentum\.pages\.dev$ (previews)

# Authentication. Production requires supabase mode.
ARDENTUM_AUTH_MODE=dev                        # dev | supabase
ARDENTUM_DEV_JWT_SECRET=change-me-to-a-long-random-string-0123456789
ARDENTUM_SUPABASE_URL=                        # https://<project>.supabase.co
ARDENTUM_SUPABASE_JWT_SECRET=                 # only for legacy HS256 projects
ARDENTUM_SUPABASE_JWT_AUDIENCE=authenticated
ARDENTUM_SUPABASE_SERVICE_KEY=                # optional secret key: account deletion also removes the sign-in record

# Abuse protection.
ARDENTUM_COMPUTE_RATE_LIMIT=60                # compute requests per client per minute (0 = off)
ARDENTUM_WRITE_RATE_LIMIT=60                  # saves, uploads, deletions, sign-in and WikiRate lookups per client per minute (0 = off)
ARDENTUM_RATE_LIMIT_STORE=auto                # auto | memory | database (shared across instances)
ARDENTUM_TRUSTED_PROXY_HOPS=0                 # 1 behind Cloud Run / Render; 0 when directly exposed
ARDENTUM_RATE_LIMIT_SECRET=                   # key for hashing IP addresses in rate-limit counters (random per process if unset)

# Optional data sources. Built in without keys: Ken French industries and risk-free
# rate, ECB exchange rates (Frankfurter), WikiRate open ESG data.
ARDENTUM_FRED_API_KEY=                        # free key: 3-month T-bill risk-free rate
ARDENTUM_WIKIRATE_API_KEY=                    # free account, only if WikiRate requires a key
ARDENTUM_TIINGO_API_KEY=                      # live prices; check licence terms before commercial use
