# Copy to backend/.env for local development. Never commit real secrets.
ARDENTUM_ENV=development                      # development | test | production
ARDENTUM_DATABASE_URL=sqlite:///./ardentum-dev.sqlite3   # production: postgresql://user:pass@host:5432/db
ARDENTUM_CORS_ORIGINS=["http://localhost:3000"]

# Authentication. Production requires supabase mode.
ARDENTUM_AUTH_MODE=dev                        # dev | supabase
ARDENTUM_DEV_JWT_SECRET=change-me-to-a-long-random-string-0123456789
ARDENTUM_SUPABASE_URL=                        # https://<project>.supabase.co
ARDENTUM_SUPABASE_JWT_SECRET=                 # only for legacy HS256 projects
ARDENTUM_SUPABASE_JWT_AUDIENCE=authenticated

# Optional live data (check licence terms before commercial use).
ARDENTUM_TIINGO_API_KEY=
ARDENTUM_FRED_API_KEY=
